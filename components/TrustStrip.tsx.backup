'use client';

import FadeIn from '@/components/animations/FadeIn';
import StaggerContainer, { StaggerItem } from '@/components/animations/StaggerContainer';

export default function TrustStrip() {
  const agencies = [
    'Canada Border Services Agency',
    'Global Affairs Canada',
    'Immigration, Refugees and Citizenship Canada',
    'Canadian Food Inspection Agency',
  ];

  return (
    <section className="relative w-full border-b border-white/10 bg-[#080A09]">
      <div className="mx-auto max-w-[1440px] px-6 lg:px-12 py-5 lg:py-6">
        <div className="flex flex-col items-center gap-6">
          {/* Label */}
          <FadeIn>
            <div className="flex items-center gap-3">
              <div className="h-[1px] w-8 bg-[#D89B20]" />
              <p className="text-[10px] lg:text-xs font-semibold uppercase tracking-widest text-[#D89B20]">
                Trusted by Government of Canada Agencies
              </p>
              <div className="h-[1px] w-8 bg-[#D89B20]" />
            </div>
          </FadeIn>

          {/* Agencies Grid */}
          <StaggerContainer staggerDelay={0.15} className="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 w-full max-w-5xl">
            {agencies.map((agency, index) => (
              <StaggerItem
                key={index}
                className="flex flex-col items-center gap-3 group cursor-pointer"
              >
                {/* Icon/Crest Placeholder */}
                <div className="relative flex h-12 w-12 items-center justify-center border border-white/10 bg-[#111513] group-hover:border-[#D89B20]/50 transition-colors">
                  <svg
                    className="h-6 w-6 text-[#55624A] group-hover:text-[#D89B20] transition-colors"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      strokeLinecap="round"
                      strokeLinejoin="round"
